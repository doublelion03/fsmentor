def cmd_fhs(args):
    header("Filesystem Hierarchy Standard (FHS) — Quick Map")
    print(
        textwrap.fill(
            "Linux organizes files by purpose, not by program. Understanding this map "
            "makes troubleshooting, package management, and system administration far easier.",
            width=70,
        )
    )
    print()

    groups = [
        ("Core / Boot", ["/", "/boot", "/dev", "/proc", "/sys", "/run"]),
        ("Essential Binaries & Libraries", ["/bin", "/sbin", "/lib"]),
        ("Installed Software", ["/usr", "/usr/bin", "/usr/sbin", "/usr/share", "/usr/local"]),
        ("Configuration", ["/etc", "/etc/apt"]),
        ("User Data", ["/home", "/root"]),
        ("Variable / Changing Data", ["/var", "/var/log", "/var/lib", "/var/cache", "/tmp"]),
        ("Optional / Mounts", ["/opt", "/media", "/mnt", "/srv"]),
    ]

    for group_name, keys in groups:
        section(group_name)
        for key in keys:
            entry = FHS[key]
            print(f"  {color(key, C.BOLD + C.CYAN):<18} {entry['purpose']}")
        print()

    tip("Use 'fsmentor path <directory>' for a deeper explanation of any location.")
    tip("Use 'fsmentor cmd <command>' or 'fsmentor pkg <package>' for real examples.")

def cmd_path(args):
    path = args.path
    if not path.startswith("/"):
        # Try to resolve relative or command-like input
        which_out, _ = run(f"which {path} 2>/dev/null")
        if which_out:
            path = which_out.splitlines()[0]
        else:
            path = os.path.abspath(path)

    key, entry = find_fhs_entry(path)

    header(f"Path Explanation: {path}")

    info("Matched FHS location", color(key, C.BOLD + C.CYAN))
    info("Name", entry["name"])
    print()
    section("Purpose")
    print(textwrap.fill(entry["purpose"], width=70, initial_indent="  ", subsequent_indent="  "))
    print()
    section("Details")
    print(textwrap.fill(entry["details"], width=70, initial_indent="  ", subsequent_indent="  "))
    print()
    if entry.get("examples"):
        section("Typical contents / examples")
        for ex in entry["examples"]:
            print(f"  • {ex}")
        print()

    # Extra live information
    if os.path.exists(path):
        section("Live information on this system")
        if os.path.islink(path):
            target = os.readlink(path)
            info("Symbolic link →", color(target, C.YELLOW))
        if os.path.isdir(path):
            try:
                count = len(os.listdir(path))
                info("Entries in directory", str(count))
            except PermissionError:
                info("Entries in directory", "(permission denied)")
        # Ownership
        try:
            st = os.stat(path)
            import pwd, grp
            owner = pwd.getpwuid(st.st_uid).pw_name
            group = grp.getgrgid(st.st_gid).gr_name
            info("Owner : Group", f"{owner} : {group}")
        except Exception:
            pass
    else:
        warn(f"Path does not currently exist on this system: {path}")

    print()
    tip("Related: fsmentor fhs  |  fsmentor cmd <name>  |  fsmentor pkg <name>")

def cmd_cmd(args):
    name = args.name
    header(f"Command / Binary Explanation: {name}")

    # which
    which_out, rc = run(f"which {name} 2>/dev/null")
    type_out, _ = run(f"bash -c 'type -a {name}' 2>/dev/null")
    whereis_out, _ = run(f"whereis -b {name} 2>/dev/null")

    if which_out:
        binary = which_out.splitlines()[0]
        info("Found executable", color(binary, C.GREEN + C.BOLD))
    else:
        binary = None
        warn(f"'{name}' not found in your $PATH")
        print()

    if type_out:
        section("Shell view (type -a)")
        for line in type_out.splitlines():
            print(f"  {line}")
        print()

    if whereis_out:
        section("whereis")
        print(f"  {whereis_out}")
        print()

    if binary:
        # Explain the directory it lives in
        key, entry = find_fhs_entry(binary)
        section(f"Why it lives in {key}")
        print(textwrap.fill(entry["purpose"], width=70, initial_indent="  ", subsequent_indent="  "))
        print()
        print(textwrap.fill(entry["details"], width=70, initial_indent="  ", subsequent_indent="  "))
        print()

        # Package ownership
        section("Package ownership (dpkg)")
        owner_out, rc = run(f"dpkg -S {binary} 2>/dev/null")
        if rc == 0 and owner_out:
            pkg = owner_out.split(":")[0].strip()
            info("Provided by package", color(pkg, C.CYAN + C.BOLD))
            print()
            tip(f"Run:  fsmentor pkg {pkg}   for full package explanation")
        else:
            print("  Not owned by any installed dpkg package (maybe manual install, snap, or flatpak).")
            print()

        # File type
        file_out, _ = run(f"file -b {binary} 2>/dev/null")
        if file_out:
            info("File type", file_out)

    print()
    tip("Try: fsmentor path /usr/bin   or   fsmentor pkg <package-name>")

def get_package_info(pkg):
    """Return dict with package information."""
    info = {"name": pkg, "installed": False, "description": "", "files": [], "raw_show": ""}

    show_out, rc = run(f"apt-cache show {pkg} 2>/dev/null")
    if rc == 0 and show_out:
        info["raw_show"] = show_out
        for line in show_out.splitlines():
            if line.startswith("Description:"):
                info["description"] = line[len("Description:"):].strip()
            elif line.startswith("Description-en:"):
                info["description"] = line[len("Description-en:"):].strip()

    # Is it installed?
    status_out, rc = run(f"dpkg -s {pkg} 2>/dev/null")
    if rc == 0 and "Status: install ok installed" in status_out:
        info["installed"] = True
        files_out, _ = run(f"dpkg -L {pkg} 2>/dev/null")
        if files_out:
            # Keep only real files (skip pure directory markers that dpkg sometimes lists)
            raw = [f for f in files_out.splitlines() if f and f != "/" and not f.endswith("/")]
            # Prefer entries that look like actual files (have an extension or are in bin/sbin/etc.)
            info["files"] = raw

    return info

def categorize_files(files):
    """Group package files by FHS category."""
    cats = {
        "binaries (/usr/bin, /bin, /usr/sbin…)": [],
        "configuration (/etc)": [],
        "libraries (/usr/lib, /lib)": [],
        "documentation (/usr/share/doc, man)": [],
        "data / state (/var)": [],
        "other": [],
    }
    for f in files:
        if any(f.startswith(p) for p in ("/usr/bin", "/bin", "/usr/sbin", "/sbin", "/usr/local/bin")):
            cats["binaries (/usr/bin, /bin, /usr/sbin…)"].append(f)
        elif f.startswith("/etc"):
            cats["configuration (/etc)"].append(f)
        elif any(f.startswith(p) for p in ("/usr/lib", "/lib", "/usr/libexec")):
            cats["libraries (/usr/lib, /lib)"].append(f)
        elif any(f.startswith(p) for p in ("/usr/share/doc", "/usr/share/man", "/usr/share/info")):
            cats["documentation (/usr/share/doc, man)"].append(f)
        elif f.startswith("/var"):
            cats["data / state (/var)"].append(f)
        else:
            cats["other"].append(f)
    return {k: v for k, v in cats.items() if v}

def cmd_pkg(args):
    pkg = args.package
    header(f"Package Explanation: {pkg}")

    pinfo = get_package_info(pkg)

    if not pinfo["raw_show"] and not pinfo["installed"]:
        warn(f"Package '{pkg}' not found in apt cache.")
        print()
        tip("Try updating the cache:  sudo apt update")
        tip("Or search:  fsmentor search " + pkg)
        return

    section("Overview")
    info("Package", color(pkg, C.BOLD + C.CYAN))
    info("Installed", color("Yes", C.GREEN) if pinfo["installed"] else color("No", C.YELLOW))
    if pinfo["description"]:
        print()
        print(textwrap.fill(pinfo["description"], width=70, initial_indent="  ", subsequent_indent="  "))
    print()

    # Show a few key fields from apt-cache show
    if pinfo["raw_show"]:
        section("Key metadata (from apt-cache show)")
        interesting = ("Package", "Version", "Priority", "Section", "Maintainer",
                       "Installed-Size", "Depends", "Homepage", "Description")
        for line in pinfo["raw_show"].splitlines():
            for key in interesting:
                if line.startswith(key + ":"):
                    print(f"  {line}")
                    break
        print()

    if pinfo["installed"] and pinfo["files"]:
        section("Where the files live (FHS view)")
        cats = categorize_files(pinfo["files"])
        for cat, filelist in cats.items():
            print(color(f"  {cat}", C.BOLD))
            # Show first few + count
            for f in filelist[:6]:
                print(f"    • {f}")
            if len(filelist) > 6:
                print(f"    … and {len(filelist) - 6} more")
            print()

        tip(f"Full list:  dpkg -L {pkg}")
        tip(f"Find which package owns a file:  dpkg -S /path/to/file")
    elif not pinfo["installed"]:
        section("What would be installed?")
        print("  Package is not installed yet. After installation, files typically go to:")
        print()
        print("  • Binaries          → /usr/bin or /usr/sbin")
        print("  • Configuration     → /etc/<package> or /etc/")
        print("  • Libraries         → /usr/lib/…")
        print("  • Documentation     → /usr/share/doc/<package>")
        print("  • State / databases → /var/lib/<package>")
        print()
        tip(f"Preview files without installing:  apt-file list {pkg}  (requires apt-file)")
        tip(f"Or install and then run:  fsmentor pkg {pkg}")

    print()
    tip("Related: fsmentor install " + pkg + "   |   fsmentor path /usr/bin")

def cmd_install(args):
    pkg = args.package
    header(f"Install Preview: {pkg}")

    pinfo = get_package_info(pkg)
    if not pinfo["raw_show"] and not pinfo["installed"]:
        warn(f"Package '{pkg}' was not found in the apt cache.")
        tip("Update the package lists first:  sudo apt update")
        tip("Then try again, or search with:  fsmentor search " + pkg)
        return

    if pinfo["installed"]:
        warn(f"'{pkg}' is already installed on this system.")
        tip(f"Inspect it with:  fsmentor pkg {pkg}")
        return

    # Clear statement of intent
    section("What you are about to do")
    print(textwrap.fill(
        f"You are preparing to install the package '{pkg}' using apt. "
        "This will download files from the configured repositories and place them "
        "on your system according to the Filesystem Hierarchy Standard (FHS).",
        width=70, initial_indent="  ", subsequent_indent="  "
    ))
    print()

    if pinfo["description"]:
        section("Package description")
        print(textwrap.fill(pinfo["description"], width=70, initial_indent="  ", subsequent_indent="  "))
        print()

    section("Where files will be placed")
    print("  Typical locations for a Debian package:")
    print()
    print(f"  {color('Binaries', C.CYAN):<20} → /usr/bin  or  /usr/sbin")
    print(f"  {color('Configuration', C.CYAN):<20} → /etc/  (often /etc/{pkg}/)")
    print(f"  {color('Libraries', C.CYAN):<20} → /usr/lib/…")
    print(f"  {color('Documentation', C.CYAN):<20} → /usr/share/doc/{pkg}/")
    print(f"  {color('Runtime data', C.CYAN):<20} → /var/lib/{pkg}/  (when needed)")
    print(f"  {color('Logs', C.CYAN):<20} → /var/log/  (for service packages)")
    print()

    section("Important notes")
    print("  • This action requires administrator privileges (sudo).")
    print("  • Dependencies will also be installed automatically by apt.")
    print("  • Configuration files under /etc are usually left alone on upgrades.")
    print("  • You can remove the package later with:  sudo apt remove " + pkg)
    print()

    tip("After a successful install you can inspect the exact files with:")
    tip("  fsmentor pkg " + pkg)
    print()

    # Strong confirmation
    if args.yes:
        proceed = True
    else:
        print(color("  ────────────────────────────────────────", C.DIM))
        print(color("  This will modify your system.", C.YELLOW + C.BOLD))
        print(color("  ────────────────────────────────────────", C.DIM))
        print()
        try:
            answer = input(color(f"  Type 'yes' to run:  sudo apt install {pkg}   [or press Enter to cancel]: ", C.BOLD)).strip().lower()
            proceed = answer in ("y", "yes")
        except (EOFError, KeyboardInterrupt):
            print()
            proceed = False

    if proceed:
        print()
        section("Running installation")
        print(f"  Executing: sudo apt install -y {pkg}")
        print()
        rc = run(f"sudo apt install -y {pkg}", capture=False)
        if rc == 0:
            print()
            tip("Installation finished.")
            tip("Inspect the package:  fsmentor pkg " + pkg)
            tip("Find its main command:  fsmentor cmd " + pkg)
        else:
            warn("The installation command returned a non-zero exit code.")
            tip("Check the output above for the reason.")
    else:
        print()
        print("  Cancelled. No changes were made to your system.")
        tip("You can run the real command yourself whenever you are ready:")
        tip("  sudo apt install " + pkg)

def cmd_search(args):
    query = args.query
    header(f"Package Search: {query}")

    out, rc = run(f"apt-cache search --names-only {query} 2>/dev/null | head -30")
    if not out:
        warn("No packages found (or apt cache is empty).")
        tip("Try: sudo apt update")
        return

    section("Matching packages (name only)")
    for line in out.splitlines():
        if " - " in line:
            name, desc = line.split(" - ", 1)
            print(f"  {color(name, C.CYAN + C.BOLD):<28} {desc[:60]}")
        else:
            print(f"  {line}")
    print()
    tip("Explain one of them:  fsmentor pkg <name>")
    tip("Smart install:        fsmentor install <name>")


def cmd_owner(args):
    """Show which package owns a given file."""
    path = args.file
    header(f"Who owns this file?  {path}")

    if not os.path.exists(path):
        # Try to resolve if it looks like a command
        which_out, _ = run(f"which {path} 2>/dev/null")
        if which_out:
            path = which_out.splitlines()[0]
            info("Resolved command to", color(path, C.GREEN))
        else:
            warn(f"Path does not exist: {path}")
            tip("Try an absolute path, e.g. /usr/bin/ls")
            return

    out, rc = run(f"dpkg -S {path} 2>/dev/null")
    if rc == 0 and out:
        # dpkg -S can return multiple lines
        for line in out.splitlines():
            if ":" in line:
                pkg, fpath = line.split(":", 1)
                info("Package", color(pkg.strip(), C.CYAN + C.BOLD))
                info("File", fpath.strip())
        print()
        tip(f"Full package explanation:  fsmentor pkg {out.split(':')[0].strip()}")
    else:
        warn("Not owned by any installed dpkg package.")
        print("  Possible reasons: manual install, snap, flatpak, or compiled from source.")
        tip("Try:  fsmentor cmd " + os.path.basename(path))


def cmd_why(args):
    """Friendly alias: decide whether the target is a path or a command."""
    target = args.target
    # Heuristic: if it starts with / or looks like a path → path, else try cmd
    if target.startswith("/") or "/" in target:
        # Re-use path logic
        class Fake:
            path = target
        cmd_path(Fake())
    else:
        class Fake:
            name = target
        cmd_cmd(Fake())


def show_welcome():
    """Friendly landing page when no command is given."""
    header("fsmentor – File System Mentor")
    print(textwrap.fill(
        "Learn the Linux filesystem and Debian packages without memorising paths. "
        "Every answer explains the *why*, not just the *what*.",
        width=70
    ))
    print()
    section("Available commands")
    print(f"  {color('fsmentor fhs', C.CYAN):<32} Map of the whole filesystem")
    print(f"  {color('fsmentor path /etc', C.CYAN):<32} Explain any directory")
    print(f"  {color('fsmentor cmd python3', C.CYAN):<32} What is this command + who owns it")
    print(f"  {color('fsmentor pkg nginx', C.CYAN):<32} Package details + where files live")
    print(f"  {color('fsmentor install htop', C.CYAN):<32} Preview and safely install a package")
    print(f"  {color('fsmentor search editor', C.CYAN):<32} Find packages by name")
    print(f"  {color('fsmentor owner /usr/bin/ls', C.CYAN):<32} Which package owns this file?")
    print(f"  {color('fsmentor why /var/log', C.CYAN):<32} Quick explanation of a path or command")
    print()
    tip("Add --help after any command for more details")
    tip("A conversational AI agent version is planned for a later release")
    print()


def main():
    parser = argparse.ArgumentParser(
        prog="fsmentor",
        description="File System Mentor – learn the Linux filesystem & Debian packages",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=textwrap.dedent("""\
            Examples:
              fsmentor                     # friendly overview
              fsmentor fhs
              fsmentor path /etc
              fsmentor cmd python3
              fsmentor pkg nginx
              fsmentor install htop
              fsmentor search editor
              fsmentor owner /usr/bin/ls
              fsmentor why /var/log

            Note: A conversational AI agent version is planned.
                  This CLI stays fast, local, and zero-dependency.
        """),
    )
    sub = parser.add_subparsers(dest="command", required=False)

    # fhs
    p_fhs = sub.add_parser("fhs", help="Explain the Filesystem Hierarchy Standard")
    p_fhs.set_defaults(func=cmd_fhs)

    # path
    p_path = sub.add_parser("path", help="Explain a filesystem path")
    p_path.add_argument("path", help="Absolute or relative path, or a command name")
    p_path.set_defaults(func=cmd_path)

    # cmd
    p_cmd = sub.add_parser("cmd", help="Explain a command / binary (enhanced which)")
    p_cmd.add_argument("name", help="Command name")
    p_cmd.set_defaults(func=cmd_cmd)

    # pkg
    p_pkg = sub.add_parser("pkg", help="Explain a Debian package")
    p_pkg.add_argument("package", help="Package name")
    p_pkg.set_defaults(func=cmd_pkg)

    # install
    p_inst = sub.add_parser("install", help="Explain a package then optionally install it")
    p_inst.add_argument("package", help="Package name")
    p_inst.add_argument("-y", "--yes", action="store_true", help="Assume yes and install")
    p_inst.set_defaults(func=cmd_install)

    # search
    p_search = sub.add_parser("search", help="Search packages by name")
    p_search.add_argument("query", help="Search term")
    p_search.set_defaults(func=cmd_search)

    # owner (new)
    p_owner = sub.add_parser("owner", help="Which package owns this file?")
    p_owner.add_argument("file", help="File path or command name")
    p_owner.set_defaults(func=cmd_owner)

    # why (friendly alias)
    p_why = sub.add_parser("why", help="Quick explanation of a path or command")
    p_why.add_argument("target", help="Path or command name")
    p_why.set_defaults(func=cmd_why)

    args = parser.parse_args()

    if not args.command:
        show_welcome()
        return

    args.func(args)


if __name__ == "__main__":
    main()
