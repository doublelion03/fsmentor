def find_fhs_entry(path: str):
    """Find the best matching FHS entry for a path."""
    path = os.path.normpath(path)
    if not path.startswith("/"):
        path = "/" + path

    # Exact match first
    if path in FHS:
        return path, FHS[path]

    # Longest prefix match
    best = None
    best_len = -1
    for key in FHS:
        if path.startswith(key.rstrip("/") + "/") or path == key:
            if len(key) > best_len:
                best = key
                best_len = len(key)
    if best:
        return best, FHS[best]

    # Try parent directories
    p = Path(path)
    while str(p) != "/":
        p = p.parent
        if str(p) in FHS:
            return str(p), FHS[str(p)]
    return "/", FHS["/"]

