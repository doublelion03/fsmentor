# ANSI colors
class C:
    RESET = "\033[0m"
    BOLD = "\033[1m"
    DIM = "\033[2m"
    RED = "\033[31m"
    GREEN = "\033[32m"
    YELLOW = "\033[33m"
    BLUE = "\033[34m"
    MAGENTA = "\033[35m"
    CYAN = "\033[36m"
    WHITE = "\033[37m"
    BG_BLUE = "\033[44m"

def color(text, *codes):
    if not sys.stdout.isatty():
        return text
    return "".join(codes) + str(text) + C.RESET

def header(title):
    print()
    print(color("═" * 64, C.CYAN))
    print(color(f"  {title}", C.BOLD + C.CYAN))
    print(color("═" * 64, C.CYAN))
    print()

def section(title):
    print(color(f"▶ {title}", C.BOLD + C.YELLOW))
    print()

def info(label, value):
    print(f"  {color(label + ':', C.DIM)} {value}")

def tip(msg):
    print(color(f"  💡 {msg}", C.GREEN))

def warn(msg):
    print(color(f"  ⚠  {msg}", C.YELLOW))

def run(cmd, capture=True, check=False):
    try:
        if capture:
            result = subprocess.run(
                cmd, shell=True, capture_output=True, text=True, timeout=30
            )
            return result.stdout.strip(), result.returncode
        else:
            return subprocess.run(cmd, shell=True, timeout=60).returncode
    except Exception as e:
        return str(e), 1

